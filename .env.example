# Flower QR Menu - Vite Environment Variables Template
# Copy this file to .env or .env.local for local frontend development.
# NOTE: Do NOT put real secrets, API keys, or private phone numbers here.

# Shop Information (Public display fallback if backend settings are not fetched)
VITE_SHOP_NAME="Tiệm Hoa Tươi Sài Gòn"
VITE_SHOP_TAGLINE="Hoa tươi mỗi ngày - Thiết kế theo yêu cầu"
VITE_SHOP_HOURS="07:30 - 21:00 hàng ngày"
VITE_SHOP_ADDRESS="123 Đường Hoa Lan, Phường 1, Quận 3, TP. Hồ Chí Minh"

# Zalo Contact Link (MUST be a valid https:// URL, e.g. https://zalo.me/0900000000)
VITE_ZALO_URL="https://zalo.me/0900000000"

# Footer and Catalog Notes
VITE_SHOP_CONTACT_NOTE="Quý khách vui lòng lưu hoặc chụp mã mẫu hoa để nhân viên phục vụ nhanh chóng nhất."
VITE_SHOP_PRICE_NOTE="Giá trên menu đã bao gồm thiệp chúc mừng và băng rôn theo yêu cầu."

# Welcome Banner Headings
VITE_SHOP_WELCOME_HEADING="Hoa tươi tuyển chọn cho khoảnh khắc đặc biệt"
VITE_SHOP_WELCOME_SUBTITLE="Chọn mẫu hoa yêu thích và gửi mã mẫu cho tiệm qua Zalo hoặc trao đổi trực tiếp tại quầy."
