{
  "name": "flower-qr-menu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "oxlint src worker scripts",
    "typecheck": "tsc --noEmit",
    "test:api": "node --test tests/webp.test.js tests/admin-api.test.js tests/integration-e2e.test.js",
    "test:browser": "node tests/browser-prod-e2e.cjs",
    "test": "npm run test:api",
    "db:migrate:local": "npx wrangler d1 migrations apply flower-menu-prod --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply flower-menu-prod --remote",
    "qr:generate": "node scripts/generate-qr.mjs",
    "deploy": "npm run build && npx wrangler deploy",
    "verify": "npm run typecheck && npm run lint && npm run test:api && npm run build"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.95.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.7"
  }
}
