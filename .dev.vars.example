# Flower QR Menu - Cloudflare Workers Local Development Environment Variables
# Copy this file to .dev.vars for local testing with `wrangler dev`.
# In production, set secrets via `npx wrangler secret put <KEY>` and public vars via `wrangler.jsonc` or dashboard.
# NOTE: Do NOT commit .dev.vars with real tokens or sensitive production emails.

# Cloudflare Zero Trust Access Configuration
# ACCESS_TEAM: Your Cloudflare Zero Trust team subdomain (e.g., https://<team>.cloudflareaccess.com)
ACCESS_TEAM="my-flower-shop"

# ACCESS_ADMIN_AUD: Application Audience (AUD) tag generated by Cloudflare Access for /admin and /api/admin/*
ACCESS_ADMIN_AUD="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ADMIN_EMAIL: Authorized admin email address(es). Supports single email or comma-separated list.
ADMIN_EMAIL="admin@example.com"

# Default Shop Profile & Content Settings (Worker API level)
SHOP_NAME="Tiệm Hoa Tươi Sài Gòn"
SHOP_TAGLINE="Hoa tươi mỗi ngày - Thiết kế theo yêu cầu"
SHOP_HOURS="07:30 - 21:00 hàng ngày"
SHOP_ADDRESS="123 Đường Hoa Lan, Phường 1, Quận 3, TP. Hồ Chí Minh"
SHOP_ZALO_URL="https://zalo.me/0900000000"
SHOP_CONTACT_NOTE="Quý khách vui lòng lưu hoặc chụp mã mẫu hoa để nhân viên phục vụ nhanh chóng nhất."
SHOP_PRICE_NOTE="Giá trên menu đã bao gồm thiệp chúc mừng và băng rôn theo yêu cầu."
SHOP_WELCOME_HEADING="Hoa tươi tuyển chọn cho khoảnh khắc đặc biệt"
SHOP_WELCOME_SUBTITLE="Chọn mẫu hoa yêu thích và gửi mã mẫu cho tiệm qua Zalo hoặc trao đổi trực tiếp tại quầy."
